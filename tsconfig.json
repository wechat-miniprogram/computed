{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitAny": false,
    "removeComments": true,
    "target": "ESNEXT",
    "lib": ["ESNEXT", "DOM"],
    "preserveConstEnums": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "typeRoots": [ "./node_modules/@types", "./node_modules/miniprogram-api-typings" ]
  },
  "include": ["./src/**/*.ts"]
}
