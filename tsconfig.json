{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitAny": false,
    "removeComments": true,
    "target": "ESNEXT",
    "lib": ["ESNEXT", "DOM"],
    "preserveConstEnums": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "jest"]
  },
  "include": ["./src/**/*.ts", "./test/**/*.ts"]
}
